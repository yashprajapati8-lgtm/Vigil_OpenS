# Copy this file to .env and fill it in. Never commit .env.

# Shared secret between the chaos controller and the services' admin ports.
# VIGIL is never given this value. Any long random string works.
CHAOS_TOKEN=change-me-to-a-long-random-string

# Normal checkout traffic, requests per second.
BASE_RPS=20

# Protects VIGIL's admin actions (baseline reset now; approvals and kill switch later).
VIGIL_ADMIN_TOKEN=change-me-to-another-long-random-string

# How much VIGIL may do alone: L0 observe, L1 advise, L2 act alone on low-risk fixes
# when confidence is High, L3 act alone on every allowed fix. Optional: vigil.yaml sets
# it for your site (`autonomy:`); a value here overrides the file.
VIGIL_AUTONOMY=L2

# How long VIGIL watches clean traffic before it trusts its baseline (seconds).
# 180 is fine for development; use 1200 (20 min) before a real demo.
VIGIL_BASELINE_SECONDS=180

# Keep learning normal from healthy traffic after that (1, default) or freeze it (0).
# Normal moves slowly and never learns an incident; a rise in latency, errors or CPU
# per request past 3 sigma of the accepted normal is reported as "baseline drift" for
# a human to accept (POST /api/baseline/accept?service=NAME with the admin token).
VIGIL_ADAPT=1

# LLM second key for diagnosis (https://console.groq.com/keys). Optional: without it,
# VIGIL diagnoses with the blame walk alone and caps confidence at Medium. Keep the real key only in .env.
GROQ_API_KEY=
# Groq retired llama-3.3-70b-versatile on 2026-08-16; gpt-oss-120b is its recommended replacement.
GROQ_MODEL=openai/gpt-oss-120b
